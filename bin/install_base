#!/usr/bin/env bash

set -euo pipefail

REPO_URL="https://mirror.cachyos.org/cachyos-repo.tar.xz"
TMP_DIR="$(mktemp -d)"

cleanup() {
    rm -rf "$TMP_DIR"
}

trap cleanup EXIT

install_dots() {
    echo "==> Installing dotfiles..."

    mv "$HOME/.config" "$HOME/.config.backup"

    git clone https://github.com/leonyaognev/.config.git \
        "$HOME/.config"

    ln -sfn "$HOME/.config/bin" "$HOME/bin"
    ln -sfn "$HOME/.config/Images" "$HOME/Images"
}

install_cachyos_repo() {
    echo "==> Installing CachyOS repository..."

    cd "$TMP_DIR"

    curl -L "$REPO_URL" -o cachyos-repo.tar.xz
    tar -xf cachyos-repo.tar.xz

    cd cachyos-repo
    sudo ./cachyos-repo.sh
}

remove_cachyos_repo() {
    echo "==> Removing CachyOS repository..."

    cd "$TMP_DIR"

    curl -L "$REPO_URL" -o cachyos-repo.tar.xz
    tar -xf cachyos-repo.tar.xz

    cd cachyos-repo
    sudo ./cachyos-repo.sh --remove
}

install_packages() {
    echo "==> Installing packages..."

    yay --noconfirm -Syu \
        base base-devel sudo grub efibootmgr reflector \
        systemd-resolvconf linux linux-headers linux-firmware nvidia-open-dkms \
        vulkan-radeon vulkan-tools dysk \
        hyprland hyprlock hyprpicker hyprshade \
        xdg-desktop-portal-hyprland xwayland-satellite swaybg mpvpaper \
        waybar-cava quickshell cava matugen rofi swaync \
        grim slurp swappy wl-clipboard wl-clip-persist \
        wl-mirror wlopm wf-recorder \
        kitty fastfetch bibata-cursor-theme terminus-font \
        ttf-jetbrains-mono ttf-jetbrains-mono-nerd \
        ttf-ms-fonts \
        noto-fonts noto-fonts-cjk noto-fonts-emoji \
        zsh fish tmux \
        eza lsd bat fd fzf ripgrep zoxide jq ncdu \
        btop nvtop ranger tty-clock cloc tg ripdrag simple-mtpfs \
        pv rsync \
        cmatrix lolcat nyancat sl cowsay hollywood \
        cool-retro-term-git terminal-oscilloscope \
        pokemon-colorscripts-git awww ratty catgirldownloader cybervis \
        neovim vim neovim-remote python-pynvim \
        opencode python uv npm \
        make gcc clang bear lcov valgrind pacgraph python-pillow \
        7zip zip unzip unrar imagemagick ascii-image-converter-bin \
        pipewire-alsa pipewire-pulse wireplumber pavucontrol \
        networkmanager \
        blueman bluez-utils \
        openssh \
        amneziavpn-bin amneziawg-go amneziawg-tools \
        wireshark-qt nmap aircrack-ng arp-scan whois traceroute ipcalc \
        docker docker-compose \
        steam steamcmd gamescope mangohud proton-ge-custom-bin \
        freesmlauncher-bin \
        qbittorrent qbittorrent-nox \
        spotify-launcher spotify-player spotatui-bin \
        firefox zen-browser-bin chromium torbrowser-launcher \
        telegram-desktop discord discordo-git \
        obsidian
}

ask() {
    local msg="$1"

    read -rp "$msg [Y/n] " answer

    case "$answer" in
        [nN][oO]|[nN])
            echo "==> Skipped."
            return 1
            ;;
        *)
            return 0
            ;;
    esac
}

install_yay() {
    if command -v yay &>/dev/null; then
        printf 'yay already installed: %s\n' "$(yay --version | head -n1)"
        return 0
    fi

    sudo pacman -S --needed --noconfirm git base-devel
    git clone https://aur.archlinux.org/yay.git "$TMP_DIR/yay"
    cd "$TMP_DIR/yay"

    makepkg -si --noconfirm
}

main() {

    ask "Run install_yay?" && install_yay

    ask "Run install_cachyos_repo?" && install_cachyos_repo

    ask "Run remove_cachyos_repo?" && remove_cachyos_repo

    ask "Run install_packages?" && install_packages

    ask "Run install_dots?" && install_dots

    echo
    echo "Done."
}

main "$@"
