#!/bin/sh

wall_dir="$HOME/Images/wallpaper/"
cache_file="$HOME/.current_wall"

# если передан аргумент — используем его, иначе выбираем рандом
if [ -n "$1" ] && [ -f "$1" ]; then
    wall="$1"
else
    files=$(find "$wall_dir" -maxdepth 1 -type f)
    [ -z "$files" ] && { echo "Файлов нет, дружище." ; exit 1; }

    files_array=()
    while IFS= read -r line; do
      files_array+=("$line")
    done <<EOF
$files
EOF

    count=${#files_array[@]}
    rand_index=$((RANDOM % count))
    wall=${files_array[$rand_index]}
fi

ext="${wall##*.}"

# копирование для разных штук
rm -rf ~/Images/paper/*
ln -sfn "$wall" ~/Images/paper/wallpaper.$ext
ln -sfn "$wall" ~/Images/paper/wallpaper
# cp "$wall" ~/.mozilla/firefox/bgnqulea.default-release/chrome/wallpaper.jpg
killall swaync

# магия с обоями
matugen image ~/Images/paper/wallpaper.$ext --prefer lightness
killall -SIGUSR1 kitty
hyprctl reload
awww img --transition-type any --transition-duration 0.5 --transition-fps 165 "$wall"
~/bin/wal_telegram --background "$wall" --palette ".cache/wal-telegram/colors.sh"

notify-send "Wallpaper successfully set"
